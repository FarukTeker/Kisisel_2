generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  newspapers   Newspaper[]
  following    Follow[]    @relation("following")
  followers    Follow[]    @relation("followers")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
}

model Newspaper {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  readingMode String   @default("F") // 'S' | 'H' | 'F'
  columns     Int      @default(3)
  theme       String   @default("Light") // 'Light' | 'Dark' | 'Sepia'
  font        String   @default("Sans-Serif (Modern Clean)")
  language    String   @default("en") // 'en' | 'tr'
  curatorId   String
  curator     User     @relation(fields: [curatorId], references: [id], onDelete: Cascade)
  widgets     Widget[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Widget {
  id             String    @id
  newspaperId    String
  newspaper      Newspaper @relation(fields: [newspaperId], references: [id], onDelete: Cascade)
  title          String
  layoutType     String // 'card1'..'card6' | 'editorial' | 'discovery'
  kind           String // 'news' | 'editorial' | 'popular' | 'random'
  publisherId    String?
  editorialBody  String?
  categoryFilter String?

  // react-grid-layout geometry
  layoutX    Int @default(0)
  layoutY    Int @default(0)
  layoutW    Int @default(1)
  layoutH    Int @default(1)
  layoutMinW Int @default(1)
  layoutMinH Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Publisher {
  id        String    @id
  name      String
  url       String
  category  String
  language  String    @default("en")
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Article {
  id          String @id
  title       String
  summary     String // RSS excerpt (~280 chars)
  fullContent String

  // AI enrichment outputs — generated once, shared by all users. Each dimension is
  // stored in both English and Turkish: enrichment writes the source language, the
  // TranslateStage fills the other. The DTO serves the field matching ?lang=.
  aiTitleEn   String? // localized title (English)
  aiTitleTr   String? // localized title (Turkish)
  aiSummaryEn String? // Scan mode (S): 2 short sentences (English)
  aiSummaryTr String? // Scan mode (S): 2 short sentences (Turkish)
  aiHeadingsEn String? // Skim mode (H): JSON string of string[] (English)
  aiHeadingsTr String? // Skim mode (H): JSON string of string[] (Turkish)
  aiFullEn    String? // Full mode (F): cleaned/rewritten full read (English)
  aiFullTr    String? // Full mode (F): cleaned/rewritten full read (Turkish)

  // Text-to-speech: Groq-generated spoken narration script per language (cached on
  // first request, then reused). The synthesized MP3 is cached on disk under cache/tts/.
  narrationScriptEn String?
  narrationScriptTr String?

  author    String
  date      String // ISO yyyy-mm-dd
  category  String
  publisher Publisher @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceUrl String
  sourceId  String
  imageUrl  String?

  // Enrichment tracking.
  enrichmentStatus String    @default("PENDING") // PENDING | PROCESSING | ENRICHED | FAILED
  enrichRetries    Int       @default(0)
  enrichLastError  String?
  enrichedAt       DateTime?
  contentHash      String // hash(title+fullContent) — enrichment idempotency key

  editions ArticleEdition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceId, date(sort: Desc)])
  @@index([date(sort: Desc)])
  @@index([enrichmentStatus, enrichRetries])
}

// A daily edition: the set of articles fetched on a given morning (Istanbul day).
// Articles are deduped (one Article row), but can belong to many editions via the
// join below — that is what makes day-by-day history possible.
model Edition {
  date      String           @id // yyyy-mm-dd (Europe/Istanbul)
  createdAt DateTime         @default(now())
  articles  ArticleEdition[]
}

model ArticleEdition {
  editionDate String
  articleId   String
  sourceId    String
  edition     Edition  @relation(fields: [editionDate], references: [date], onDelete: Cascade)
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([editionDate, articleId])
  @@index([editionDate])
}
