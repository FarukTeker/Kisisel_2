# Copy to .env and fill in. .env is gitignored — never commit real keys.

DATABASE_URL="file:./dev.db"
JWT_SECRET="change_me_in_production"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN=http://localhost:3000

# AI summaries & translation (https://console.groq.com)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"

# Text-to-speech narration (Google Cloud Text-to-Speech). Optional — narration
# is disabled gracefully if GOOGLE_TTS_API_KEY is empty.
GOOGLE_TTS_API_KEY=""
GOOGLE_TTS_VOICE_EN="en-US-Standard-C"
GOOGLE_TTS_LANG_EN="en-US"
GOOGLE_TTS_VOICE_TR="tr-TR-Standard-A"
GOOGLE_TTS_LANG_TR="tr-TR"
