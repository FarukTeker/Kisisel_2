{
  "expo": {
    "name": "Kişisel",
    "slug": "kisisel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kisisel-icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/kisisel-icon.png"
    },
    "android": {
      "package": "com.kisisel.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/kisisel-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/kisisel-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/kisisel-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "http://kisisel.ink:4000",
      "router": {},
      "eas": {
        "projectId": "a69348cc-35e5-4c5f-bdcf-beeb43f99a5f"
      }
    },
    "owner": "zybo1000"
  }
}
